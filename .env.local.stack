# Environment for the LOCAL Supabase stack. Safe to commit.
#
# Every value here is either a Supabase demo key -- identical on every local
# install, published in Supabase's own documentation, and useless against any
# real project -- or an obvious placeholder. There is no production secret in
# this file, and there must never be one.
#
# WHY IT EXISTS
#
# `next build` is a definition-of-done gate for the search refactor, but a
# fresh worktree has no .env.local, so the build dies at
# /api/cron/capacity-drift with "supabaseUrl is required" before it can tell
# you anything about your code. That turns a real gate into a skipped one at
# every block.
#
# USE
#
#   npx supabase start
#   npx supabase db reset            # genesis + live migrations
#   cp .env.local.stack .env.local   # or: env $(cat .env.local.stack | xargs) npx next build
#   npx next build
#
# For work against the real project, copy .env.local.example instead and fill
# in the real values -- and keep that file out of git, as it already is.

# --- Supabase local stack -------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# --- Application ----------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Placeholders: present so the build can resolve them, not functional ---
UPLOADTHING_SECRET=sk_live_local_placeholder
UPLOADTHING_APP_ID=local-placeholder
RESEND_API_KEY=re_local_placeholder
CRON_SECRET=local-stack-not-a-secret
STRIPE_SECRET_KEY=sk_test_local_placeholder
STRIPE_WEBHOOK_SECRET=whsec_local_placeholder
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_local_placeholder
